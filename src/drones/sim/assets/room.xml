<mujoco model="drones room">
  <!-- Training scene: a floor, four walls and a ceiling. The walls and the ceiling are mocap
       bodies, so every parallel world can place them differently; drones.sim.hover_env samples
       a new room per episode. Anything added to <worldbody> is seen by the simulated sensors. -->
  <option integrator="RK4" density="1.225" viscosity="1.8e-5"/>
  <compiler inertiafromgeom="false" autolimits="true"/>
  <statistic center="0 0 1" extent="3"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.5 0.5 0.5" specular="0 0 0"/>
    <global azimuth="-20" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
             rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="512" height="512"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="2 2" reflectance="0.2"/>
  </asset>

  <default>
    <!-- Group 1 is visible to the sensors' rays. No contacts: crashes are detected from the
         room geometry and the rangers, which is cheaper than MuJoCo collision. -->
    <default class="room">
      <geom type="box" group="1" contype="0" conaffinity="0"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <body name="wall_px" mocap="true" pos="2 0 0"><geom class="room" size="0.05 20 20" rgba="0.75 0.35 0.3 1"/></body>
    <body name="wall_nx" mocap="true" pos="-2 0 0"><geom class="room" size="0.05 20 20" rgba="0.3 0.55 0.75 1"/></body>
    <body name="wall_py" mocap="true" pos="0 2 0"><geom class="room" size="20 0.05 20" rgba="0.4 0.7 0.35 1"/></body>
    <body name="wall_ny" mocap="true" pos="0 -2 0"><geom class="room" size="20 0.05 20" rgba="0.8 0.7 0.3 1"/></body>
    <body name="ceiling" mocap="true" pos="0 0 2.5"><geom class="room" size="20 20 0.05" rgba="0.85 0.85 0.85 1"/></body>
  </worldbody>
</mujoco>
