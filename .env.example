# --- Crazyflie connection ---------------------------------------------------
# "auto" scans and uses whatever single interface is present, which covers
# both a Crazyradio dongle and the drone plugged straight in over USB.
# Or set it explicitly:
#   radio://<radio index>/<channel>/<datarate>/<address>
#   usb://0
CFLIB_URI=auto

# --- Flight envelope (metres, m/s) ------------------------------------------
TAKEOFF_HEIGHT=1.0
TAKEOFF_VELOCITY=0.3
MIN_ALTITUDE=0.2
MAX_ALTITUDE=2.0

# --- Obstacle avoidance -----------------------------------------------------
AVOID_DISTANCE=0.9
AVOID_HARD_DISTANCE=0.35
MAX_AVOID_SPEED=0.6
CEILING_DISTANCE=0.5

# --- Manual control: turn rate and climb rate ---
MAX_MANUAL_SPEED=0.4
MAX_CLIMB_SPEED=0.3
MAX_YAW_RATE=90.0

# --- Autonomous mode --------------------------------------------------------
MAX_FLIGHT_TIME=60.0

# --- Web server -------------------------------------------------------------
WEB_HOST=0.0.0.0
WEB_PORT=8000
# Leave empty for no auth. If set, the page and WebSocket require ?token=...
WEB_TOKEN=

# Seconds of client silence before the drone stops moving / lands.
STICK_TIMEOUT=0.7
LINK_TIMEOUT=3.0
